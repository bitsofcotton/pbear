< 	status = RS->SetVariable(L"OsIndications", &global, osind_attrs,
< 	    sizeof(osind), &osind);
< 	if (status != EFI_SUCCESS) {
< 		printf("%s: %d\n", __func__, status);
< 		return -1;
< 	}
< 
< 	RS->ResetSystem(EfiResetCold, EFI_SUCCESS, 0, NULL);
< 	for (;;)
