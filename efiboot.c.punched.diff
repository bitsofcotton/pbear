< Xfwsetup_efi(void)
< {
< 	UINT64 osind;
< 	UINTN osind_size = sizeof(osind);
< 	UINT32 osind_attrs = 0x1 | 0x2 | 0x4;
< 	EFI_GUID global = EFI_GLOBAL_VARIABLE;
< 	EFI_STATUS status;
