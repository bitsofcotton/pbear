< void
< efi_cleanup(void)
< {
< 	int		 retry;
< 	EFI_STATUS	 status;
< 
< 	/* retry once in case of failure */
< 	for (retry = 1; retry >= 0; retry--) {
< 		efi_memprobe_internal();	/* sync the current map */
< 		status = BS->ExitBootServices(IH, mmap_key);
< 		if (status == EFI_SUCCESS)
< 			break;
< 		if (retry == 0)
< 			panic("ExitBootServices failed (%d)", status);
< 	}
< }
