< /* see lib/libsa/softraid.c sr_crypto_passphrase_decrypt() */
< void
< idle_poweroff(void)
< {
< 	if (get_idle_timeout() == 0 && sleep(idle_secs) == 0) {
< 		printf("\nno input after %us, powering off...\n", idle_secs);
< 		Xpoweroff_efi();
< 	}
